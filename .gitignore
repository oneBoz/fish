# ---- macOS ----
.DS_Store
._*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# virtualenvs (root and light_tracker/laptop)
.venv/
venv/
env/

# ---- Secrets / local config ----
.env
.env.*
*.local

# ---- Model weights (YOLO --yolo weights.pt) ----
*.pt
*.pth
*.onnx

# ---- Flight logs / recordings exported by the GCS ----
logs/
*.log
flight_*.json
flight_*.csv

# ---- YOLO training (regenerate with tools/synth + tools/train_quads.py) ----
datasets/
runs/
# trained weights are covered by *.pt / *.onnx above; keep the tiny class list
!models/quads.names
# base weights ultralytics downloads into the repo root
yolo11n*.pt

# ---- GCS downloads (Log panel) ----
maelstrom-flight*.json
maelstrom-flight*.csv

# ---- Headless-browser profiles and screenshots from local checks ----
chrome-*/
shots*/

# ---- Arduino / ESP32 build output ----
build/
*.bin
*.elf
*.hex
*.map
.pio/
# Arduino IDE 2 puts these next to sketches
**/*.ino.*
!**/*.ino

# ---- Editors ----
.vscode/
.idea/
*.swp
*.swo
*~
